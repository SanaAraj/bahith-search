# Copy to .env and fill in. Only OPENAI_API_KEY is required for LLM answers;
# retrieval works without it.

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.1-8b-instant

# --- Embeddings ---
EMBEDDING_MODEL=Omartificial-Intelligence-Space/Arabic-Triplet-Matryoshka-V2

# --- Retrieval ---
SEARCH_ALPHA=0.7
TOP_K=5

# --- Observability (optional; tracing is off unless enabled) ---
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Benchmark cost estimation (per 1M tokens; match your provider) ---
LLM_INPUT_COST_PER_1M=0.05
LLM_OUTPUT_COST_PER_1M=0.08
